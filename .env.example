# .env – LOKÁLNÍ konfigurace pro běh mimo GitHub Actions
# Zkopíruj na .env (nikdy necommituj — viz .gitignore) a vyplň hodnoty.
#
# GitHub Actions má SMTP nastavené přímo v .github/workflows/bazar_check.yml
# (env: blok), takže pro CI tenhle soubor nepotřebuješ.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tvuj@gmail.com
SMTP_PASS=gmail-app-password-16-znaku
ALERT_EMAIL=kam@posilat.cz
